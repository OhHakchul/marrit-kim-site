        </div>
      </section>

      <section class="center-section">
        <h2 class="section-title">Contact</h2>
        <div class="links-card contact-card">
          <ul class="media-links">
            <li id="email-container"> </li> 
      
            <li><strong>LinkedIn:</strong> <a href="https://www.linkedin.com/in/marrit-kim-van-der-staaij-b8a227153" target="_blank">Marrit Kim van der Staaij</a></li>
            <li><strong>Instagram:</strong> <a href="https://www.instagram.com/cheesesaykimchi" target="_blank">@cheesesaykimchi</a></li>
          </ul>
        </div>
      </section>

    </main>

    <footer class="site-footer">
      <p>
        Website created by <a href="https://www.instagram.com/hakchuloh/" target="_blank">Hakchul Oh</a>
      </p>
    </footer>
