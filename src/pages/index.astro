  </body>
</html>

<style>
  /* --- GLOBAL VARIABLES & RESET --- */
  :root {
    --bg-color: #fdfbf7;
    --text-main: #222;
    --text-light: #444;
    --accent: #000;
    
    --freckle-1: rgba(160, 82, 45, 0.15); 
    --freckle-2: rgba(139, 69, 19, 0.1);  
    --freckle-3: rgba(205, 133, 63, 0.12); 
  }
  
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    scroll-snap-type: y proximity;
  }

  body {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    background-color: var(--bg-color);
    color: var(--text-main);
    line-height: 1.7;
    overflow-x: hidden;
    
    background-image: 
      radial-gradient(circle, var(--freckle-1) 1px, transparent 1.5px),
      radial-gradient(circle, var(--freckle-2) 1.5px, transparent 2px),
      radial-gradient(circle, var(--freckle-3) 1px, transparent 1.5px);
    background-size: 35px 35px, 55px 55px, 85px 85px;
    background-position: 0 0, 15px 25px, 45px 65px;
  }

  /* --- HERO SECTION --- */
  .hero {
    position: relative;
    width: 100vw;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
    scroll-snap-align: start;
  }

  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.4);
    z-index: 2;
  }

  .hero-text {
    position: relative;
    z-index: 3;
    padding: 0 20px;
  }

  .hero-text h1 {
    font-size: 3.5rem;
    letter-spacing: 4px;
    margin-bottom: 10px;
    font-weight: 700;
  }

  .hero-text h2 {
    font-size: 2rem;
    letter-spacing: 3px;
    font-weight: 300;
    margin-bottom: 20px;
  }

  .hero-text p {
    font-size: 1.2rem;
    letter-spacing: 2px;
    border-top: 1px solid rgba(255,255,255,0.5);
    padding-top: 10px;
    display: inline-block;
  }

  .scroll-indicator {
    position: absolute;
    bottom: 40px;
    z-index: 3;
    font-size: 0.9rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    animation: bounce 2s infinite;
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  /* --- MAIN CONTENT CONTAINER --- */
  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 100px 20px 60px; /* added bottom padding */
    display: flex;
    flex-direction: column;
    gap: 120px;
  }

  /* --- TYPOGRAPHY --- */
  .section-title {
    font-size: 2.2rem;
    font-weight: 700;
    margin-bottom: 30px;
    border-bottom: 2px solid #ddd;
    padding-bottom: 10px;
    display: inline-block;
  }

  p {
    font-size: 1.1rem;
    color: var(--text-light);
    margin-bottom: 20px;
  }

  /* --- LAYOUT STRUCTURES --- */
  .split-section {
    display: flex;
    align-items: center;
    gap: 60px;
    scroll-snap-align: start;
    scroll-margin-top: 80px;
  }

  .split-section.reverse {
    flex-direction: row-reverse;
  }

  .image-wrapper {
    flex: 1;
  }

  .text-wrapper {
    flex: 1;
  }

  .center-section {
    text-align: center;
    scroll-snap-align: start;
    scroll-margin-top: 80px;
  }

  .center-section .section-title {
    margin-bottom: 50px;
  }
  .featured-speech {
    font-size: 1.8rem; /* Adjust this number to go bigger or smaller */
    font-weight: 700;
    display: inline-block;
    margin-bottom: 20px;
  }
  /* --- SPECIFIC ELEMENTS --- */
  .portrait {
    width: 100%;
    border-radius: 12px;
    box-shadow: 0 15px 30px rgba(0,0,0,0.1);
    object-fit: cover;
    aspect-ratio: 4/5;
  }

  .bg-card {
    background: white;
    padding: 40px;
    border-radius: 12px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.05);
    border: 1px solid #eee;
  }

  .eyebrow {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #888;
    font-weight: bold;
    display: block;
    margin-bottom: 10px;
  }

  .book-title {
    font-size: 2.5rem;
    margin-bottom: 10px;
  }

  .quote {
    font-style: italic;
    color: #666;
    font-size: 1.2rem;
    margin-bottom: 25px;
  }

  .book-img {
    width: 100%;
    max-width: 350px;
    border-radius: 8px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.15);
  }

  /* --- GRIDS --- */
  .grid-3 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
    margin-bottom: 40px;
  }

  .card {
    background: white;
    padding: 30px;
    border-radius: 12px;
    text-decoration: none;
    color: var(--text-main);
    border: 1px solid #eee;
    box-shadow: 0 4px 6px rgba(0,0,0,0.02);
    transition: transform 0.3s, box-shadow 0.3s;
    text-align: left;
    display: flex;
    flex-direction: column;
  }

  .card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.08);
  }

  .card h3 {
    font-size: 1.3rem;
    margin-bottom: 15px;
  }
  
  .card-links {
    margin-top: auto;
    padding-top: 15px;
  }
  
  .card-links a {
    color: #666;
    text-decoration: none;
    font-weight: bold;
  }
  
  .card-links a:hover {
    color: var(--accent);
  }

  .panel-img {
    width: 100%;
    border-radius: 12px;
    box-shadow: 0 8px 16px rgba(0,0,0,0.1);
  }

  /* --- LISTS & LINKS --- */
  .links-card {
    background: white;
    padding: 40px;
    border-radius: 12px;
    border: 1px solid #eee;
    text-align: left;
    max-width: 600px;
    margin: 0 auto;
  }

  .contact-card {
    text-align: center;
  }
  
  .contact-card li {
    margin-bottom: 20px;
  }

  .links-card h3 {
    font-size: 1.5rem;
    margin-bottom: 25px;
  }

  .media-links {
    list-style: none;
  }

  .media-links li {
    margin-bottom: 15px;
  }

  .media-links a {
    text-decoration: none;
    color: var(--text-main);
    font-size: 1.1rem;
    border-bottom: 1px solid #ccc;
    padding-bottom: 2px;
    transition: color 0.2s, border-color 0.2s;
  }

  .media-links a:hover {
    color: #000;
    border-bottom-color: #000;
  }

  /* --- FOOTER --- */
  .site-footer {
    text-align: center;
    padding: 40px 20px;
    font-size: 0.9rem;
    color: #888;
    background-color: transparent;
    opacity: 0.8;
  }

  .site-footer a {
    color: #555;
    text-decoration: none;
    border-bottom: 1px dotted #888;
    transition: color 0.2s;
  }

  .site-footer a:hover {
    color: #000;
    border-bottom: 1px solid #000;
  }

  /* --- RESPONSIVE DESIGN FOR PHONES --- */
  @media (max-width: 768px) {
    .hero-text h1 { font-size: 2rem; }
    .split-section, .split-section.reverse { flex-direction: column; }
    .grid-2 { grid-template-columns: 1fr; }
    .container { gap: 80px; padding: 60px 20px; }
  }
</style>