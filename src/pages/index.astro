---
// src/pages/index.astro
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Your Site Title</title>
  </head>
  <body class="bg-[#fafafa] text-gray-800 font-sans antialiased">
    
    <main class="max-w-3xl mx-auto px-6 py-16 flex flex-col items-center text-center">
      
      <div class="w-40 h-40 rounded-full shadow-md mb-6 z-10 bg-gray-200 border-4 border-white flex items-center justify-center text-gray-400 font-bold">
        [Profile Image]
      </div>
      
      <h1 class="text-2xl md:text-3xl font-bold tracking-[0.2em] uppercase mb-4 text-gray-900">
        Main Headline . Keyword . Keyword
      </h1>
      
      <p class="text-lg text-gray-600 mb-16 max-w-xl z-10 bg-[#fafafa] px-4">
        Your introductory paragraph goes here. This is a placeholder for a brief overview of the website's purpose or a short personal bio.
      </p>

      <div class="relative w-full flex flex-col items-center">
        
        <div class="absolute top-0 bottom-0 w-[2px] bg-gray-300 z-0"></div>

        <div class="relative z-10 flex flex-col items-center mb-24 w-full">
          <div class="w-5 h-5 rounded-full bg-gray-800 border-4 border-[#fafafa] mb-6"></div>
          
          <div class="bg-white p-5 rounded-2xl shadow-lg w-full max-w-lg transition-transform duration-300 hover:-translate-y-2 text-left">
            <div class="bg-gray-100 rounded-xl w-full h-64 mb-5 flex items-center justify-center text-gray-400">
              [Image Placeholder 1]
            </div>
            <h2 class="text-2xl font-bold mb-3 text-gray-900">Section Title 1</h2>
            <p class="text-gray-600 mb-4 leading-relaxed">Description for your first major section goes here. Keep it concise and visually balanced.</p>
            <a href="#" class="inline-block text-gray-800 font-bold border-b-2 border-transparent hover:border-gray-800 transition-colors pb-1">Link Text →</a>
          </div>
        </div>

        <div class="relative z-10 flex flex-col items-center mb-24 w-full">
          <div class="w-5 h-5 rounded-full bg-gray-800 border-4 border-[#fafafa] mb-6"></div>
          
          <div class="bg-white p-5 rounded-2xl shadow-lg w-full max-w-lg transition-transform duration-300 hover:-translate-y-2 text-left">
            <div class="bg-gray-100 rounded-xl w-full h-64 mb-5 flex items-center justify-center text-gray-400">
              [Image Placeholder 2]
            </div>
            <h2 class="text-2xl font-bold mb-3 text-gray-900">Section Title 2</h2>
            <p class="text-gray-600 mb-4 leading-relaxed">Description for your second major section goes here. This follows the vertical flow down the page.</p>
            <a href="#" class="inline-block text-gray-800 font-bold border-b-2 border-transparent hover:border-gray-800 transition-colors pb-1">Link Text →</a>
          </div>
        </div>

        <div class="relative z-10 flex flex-col items-center mb-12 w-full">
          <div class="w-5 h-5 rounded-full bg-gray-800 border-4 border-[#fafafa] mb-6"></div>
          
          <div class="bg-white p-5 rounded-2xl shadow-lg w-full max-w-lg transition-transform duration-300 hover:-translate-y-2 text-left">
            <div class="bg-gray-100 rounded-xl w-full h-64 mb-5 flex items-center justify-center text-gray-400">
              [Image Placeholder 3]
            </div>
            <h2 class="text-2xl font-bold mb-3 text-gray-900">Section Title 3</h2>
            <p class="text-gray-600 mb-4 leading-relaxed">Description for your third major section goes here. The timeline anchors to this final card.</p>
            <a href="#" class="inline-block text-gray-800 font-bold border-b-2 border-transparent hover:border-gray-800 transition-colors pb-1">Link Text →</a>
          </div>
        </div>

      </div>

      <div class="mt-12 z-10 bg-[#fafafa] px-8 py-8 w-full border-t border-gray-200">
        <h2 class="text-3xl font-bold mb-8 text-gray-900">Footer Headline</h2>
        <a href="#" class="inline-block bg-gray-900 text-white px-10 py-4 rounded-full font-bold tracking-wide hover:bg-gray-700 transition-colors shadow-md">
          Action Button
        </a>
      </div>

    </main>
  </body>
</html>